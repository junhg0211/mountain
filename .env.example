CLIENT_ID=
# Public identifier used by the Discord Activity client (same value as CLIENT_ID).
# The server exposes CLIENT_ID through root layout data; no client secret is exposed.
CLIENT_SECRET=
REDIRECT_URI=http://localhost:5173/api/login
DASHBOARD_URL=http://localhost:5173
BOT_TOKEN=
REGISTER_COMMANDS=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=mountain
DB_USER=
DB_PASS=

# TOKUCRYPT: generate each 32-byte key with `openssl rand -hex 32`.
# Persist keys across deployments. Retain previous entries during rotation.
TOKUCRYPT_ACTIVE_KEY_ID=v1
TOKUCRYPT_KEYS=
# Example shape only: {"v1":"<64 hex characters>"}

# Key exchange uses X25519; no DH parameter or signing-key configuration is required.
